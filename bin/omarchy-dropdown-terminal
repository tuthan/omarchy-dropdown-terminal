#!/usr/bin/env bash

set -u

hidden_workspace="dropdown-terminal-hidden"

die() {
  printf 'Dropdown Terminal: %s\n' "$1" >&2
  exit 1
}

is_private_dir() {
  local dir="$1"
  local mode

  [[ -d "$dir" && ! -L "$dir" && -O "$dir" ]] || return 1
  mode="$(stat -c '%a' "$dir" 2>/dev/null)" || return 1
  (( (8#$mode & 077) == 0 ))
}

state_dir() {
  local dir="${XDG_RUNTIME_DIR:-}"
  local old_umask

  if [[ -n "$dir" ]] && is_private_dir "$dir"; then
    printf '%s\n' "$dir"
    return
  fi

  dir="/tmp/omarchy-dropdown-terminal-${UID:-$(id -u)}"
  if [[ -e "$dir" || -L "$dir" ]]; then
    is_private_dir "$dir" || die "refusing insecure state directory: $dir"
  else
    old_umask="$(umask)"
    umask 077
    mkdir "$dir" || die "could not create state directory: $dir"
    umask "$old_umask"
  fi

  chmod 700 "$dir" 2>/dev/null || true
  is_private_dir "$dir" || die "state directory is not private: $dir"
  printf '%s\n' "$dir"
}

state_root="$(state_dir)" || exit $?
state_file="$state_root/previous-workspace"
address_file="$state_root/address"

hl_dispatch() {
  hyprctl eval "hl.dispatch($1)"
}

client_exists() {
  local address="$1"
  hyprctl clients -j 2>/dev/null \
    | jq -e --arg address "$address" 'any(.[]; .address == $address)' >/dev/null 2>&1
}

client_workspace() {
  local address="$1"
  hyprctl clients -j 2>/dev/null \
    | jq -r --arg address "$address" '.[] | select(.address == $address) | .workspace.name' \
    | head -n 1
}

is_client_address() {
  [[ "$1" =~ ^0x[[:xdigit:]]+$ ]]
}

lua_string() {
  local value="$1"

  # Control characters cannot be represented safely in the inline Lua source.
  [[ "$value" =~ [[:cntrl:]] ]] && return 1
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

workspace_selector() {
  local workspace="$1"
  if [[ "$workspace" =~ ^[0-9]+$ ]]; then
    printf '%s' "$workspace"
  else
    printf 'name:%s' "$workspace"
  fi
}

active_workspace="$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.name // "1"')"
terminal_address="$(cat "$address_file" 2>/dev/null || true)"

# Recover the tracked client after shell restarts. Also migrate a client left
# in the old visible workspace used by earlier plugin versions.
if [[ -z "$terminal_address" ]] || ! client_exists "$terminal_address"; then
  terminal_address="$(hyprctl clients -j 2>/dev/null | jq -r --arg hidden "$hidden_workspace" \
    '.[] | select(.workspace.name == $hidden) | .address' | head -n 1)"
fi
if [[ -z "$terminal_address" ]]; then
  terminal_address="$(hyprctl clients -j 2>/dev/null | jq -r \
    '.[] | select(.workspace.name == "dropdown-terminal") | .address' | head -n 1)"
fi

if [[ -n "$terminal_address" ]] && is_client_address "$terminal_address" && client_exists "$terminal_address"; then
  printf '%s\n' "$terminal_address" > "$address_file"
  terminal_workspace="$(client_workspace "$terminal_address")"
  terminal_window="$(lua_string "address:$terminal_address")" || die "invalid terminal address"

  if [[ "$terminal_workspace" == "$hidden_workspace" ]]; then
    # Show it on the workspace the user is currently using.
    target_workspace="$(workspace_selector "$active_workspace")"
    target_workspace_lua="$(lua_string "$target_workspace")" || die "invalid workspace name"
    printf '%s\n' "$active_workspace" > "$state_file"
    hl_dispatch "hl.dsp.window.move({ workspace = $target_workspace_lua, follow = false, window = $terminal_window })" >/dev/null
    hl_dispatch "hl.dsp.focus({ window = $terminal_window })" >/dev/null
  else
    # Hide it without changing the user's current workspace.
    printf '%s\n' "$terminal_workspace" > "$state_file"
    hl_dispatch "hl.dsp.window.move({ workspace = \"name:$hidden_workspace\", follow = false, window = $terminal_window })" >/dev/null
  fi
  exit $?
fi

before_clients="$(hyprctl clients -j 2>/dev/null | jq -r '.[].address' | sort)"
target_workspace="$(workspace_selector "$active_workspace")"

# Launch through Omarchy so xdg-terminal-exec selects the configured emulator.
omarchy launch terminal >/dev/null 2>&1 &

for _ in $(seq 1 40); do
  current="$(hyprctl clients -j 2>/dev/null | jq -r --arg before "$before_clients" '
    .[] | .address as $address
    | select((($before | split("\n")) | index($address)) == null)
    | $address' | head -n 1)"
  current="${current:-0x0}"

  if [[ "$current" != "0x0" ]] && is_client_address "$current"; then
    monitor_width="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .width' | head -n 1)"
    monitor_height="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .height' | head -n 1)"
    monitor_scale="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .scale' | head -n 1)"
    [[ "$monitor_width" =~ ^[0-9]+$ ]] || monitor_width=1920
    [[ "$monitor_height" =~ ^[0-9]+$ ]] || monitor_height=1080
    [[ "$monitor_scale" =~ ^[0-9]+([.][0-9]+)?$ ]] || monitor_scale=1

    # Hyprland scales integer resize/move values by monitor scale, so convert
    # the focused monitor into logical space first and size from that.
    logical_width="$(awk -v width="$monitor_width" -v scale="$monitor_scale" 'BEGIN { if (scale <= 0) scale = 1; printf "%d", width / scale }')"
    logical_height="$(awk -v height="$monitor_height" -v scale="$monitor_scale" 'BEGIN { if (scale <= 0) scale = 1; printf "%d", height / scale }')"
    window_width="$(awk -v width="$logical_width" 'BEGIN { printf "%d", width * 0.90 }')"
    window_height="$(awk -v height="$logical_height" 'BEGIN { printf "%d", height * 0.45 }')"
    top_margin="$(awk -v height="$logical_height" 'BEGIN { margin = height * 0.04; if (margin < 24) margin = 24; printf "%d", margin }')"
    window_x=$(((logical_width - window_width) / 2))

    current_window="$(lua_string "address:$current")" || die "invalid terminal address"
    printf '%s\n' "$current" > "$address_file"
    printf '%s\n' "$active_workspace" > "$state_file"
    hl_dispatch "hl.dsp.focus({ window = $current_window })" >/dev/null
    hl_dispatch "hl.dsp.window.float({ action = \"set\", window = $current_window })" >/dev/null
    hl_dispatch "hl.dsp.window.resize({ x = $window_width, y = $window_height, window = $current_window })" >/dev/null
    hl_dispatch "hl.dsp.window.move({ x = $window_x, y = $top_margin, relative = false, window = $current_window })" >/dev/null
    exit $?
  fi
  sleep 0.1
done

exit 0
