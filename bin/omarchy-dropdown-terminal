#!/usr/bin/env bash

set -u

special_workspace="dropdown-terminal"
legacy_workspace="dropdown-terminal-hidden"

die() {
  printf 'Dropdown Terminal: %s\n' "$1" >&2
  exit 1
}

action="${1:-toggle}"
[[ "$action" == "toggle" || "$action" == "hide" || "$action" == "cleanup" ]] || die "unknown action: $action"

window_width_percent="${2:-90}"
window_height_percent="${3:-45}"
border_color="${4:-theme}"
slide_from_top="${5:-1}"

[[ "$window_width_percent" =~ ^[0-9]+$ ]] || window_width_percent=90
[[ "$window_height_percent" =~ ^[0-9]+$ ]] || window_height_percent=45
(( window_width_percent = window_width_percent < 20 ? 20 : window_width_percent > 100 ? 100 : window_width_percent ))
(( window_height_percent = window_height_percent < 20 ? 20 : window_height_percent > 100 ? 100 : window_height_percent ))

if [[ "$border_color" != "theme" && ! "$border_color" =~ ^(rgb|rgba)\([[:xdigit:]]+\)$ ]]; then
  border_color="theme"
fi

[[ "$slide_from_top" == "0" || "$slide_from_top" == "1" ]] || slide_from_top=1

# Geometry computed by compute_geometry / live_geometry. Coordinates are
# global desktop coordinates, anchored at the focused monitor's origin.
window_width=0
window_height=0
window_x=0
top_margin=0
parked_y=0
monitor_x=0
monitor_y=0

is_private_dir() {
  local dir="$1"
  local mode

  [[ -d "$dir" && ! -L "$dir" && -O "$dir" ]] || return 1
  mode="$(stat -c '%a' "$dir" 2>/dev/null)" || return 1
  (( (8#$mode & 077) == 0 ))
}

state_dir() {
  local dir="${XDG_RUNTIME_DIR:-}"
  local old_umask

  if [[ -n "$dir" ]] && is_private_dir "$dir"; then
    printf '%s\n' "$dir"
    return
  fi

  dir="/tmp/omarchy-dropdown-terminal-${UID:-$(id -u)}"
  if [[ -e "$dir" || -L "$dir" ]]; then
    is_private_dir "$dir" || die "refusing insecure state directory: $dir"
  else
    old_umask="$(umask)"
    umask 077
    mkdir "$dir" || die "could not create state directory: $dir"
    umask "$old_umask"
  fi

  chmod 700 "$dir" 2>/dev/null || true
  is_private_dir "$dir" || die "state directory is not private: $dir"
  printf '%s\n' "$dir"
}

state_root="$(state_dir)" || exit $?
address_file="$state_root/address"
animation_file="$state_root/special-animation"

# Serialize every invocation behind one lock: overlapping runs would otherwise
# snapshot the animation config mid-suppression and later "restore" the
# suppressed values. The shell instantiates the widget once per monitor, so a
# single hotkey press arrives as two near-simultaneous toggles with separate
# QML state; a toggle that finds the lock held is therefore a duplicate press,
# not a queued intent, and must be dropped. Other actions queue briefly.
# The name is plugin-specific because state_root may be XDG_RUNTIME_DIR
# itself, which other programs also write to.
exec 9>"$state_root/io.github.tuthan.dropdown-terminal.lock" 2>/dev/null || true
if [[ "$action" == "toggle" ]]; then
  flock -n 9 || exit 0
else
  flock -w 3 9 || exit 0
fi

# Terminating signals must not resume execution after the handler; exiting
# with the conventional code runs the EXIT restoration path armed by
# suppress_special_animation, or nothing when suppression was never engaged.
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

hl_dispatch() {
  hyprctl eval "hl.dispatch($1)"
}

ensure_floating() {
  local address="$1"
  local window_lua="$2"
  local floating
  local attempt

  # Hyprland applies float asynchronously, and ignores it entirely for windows
  # on hidden workspaces. Retry until the client reports floating.
  for attempt in $(seq 1 6); do
    hl_dispatch "hl.dsp.window.float({ action = \"set\", window = $window_lua })" >/dev/null
    sleep 0.1
    floating="$(hyprctl clients -j 2>/dev/null | jq -r --arg address "$address" \
      '.[] | select(.address == $address) | .floating' | head -n 1)"
    [[ "$floating" == "true" ]] && return 0
  done
  return 1
}

set_border_color() {
  local address="$1"
  local window_lua color_lua

  window_lua="$(lua_string "address:$address")" || return 1
  if [[ "$border_color" == "theme" ]]; then
    color_lua='"default"'
  else
    color_lua="$(lua_string "$border_color")" || return 1
  fi

  hyprctl eval "hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"active_border_color\", value = $color_lua }))" >/dev/null 2>&1 || true
  hyprctl eval "hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"inactive_border_color\", value = $color_lua }))" >/dev/null 2>&1 || true
}

# Hyprland has no per-workspace animation control and no way to reverse the
# direction of a "slidevert" special workspace, so the reveal is made instant
# and the visible motion is driven by an animated window move instead.
#
# Only the specialWorkspace parent node is touched: specialWorkspaceIn and
# specialWorkspaceOut keep their own enabled flags but resolve their speed,
# bezier, and style through the tree at use time (verified on Hyprland
# 0.56.2), so a fast parent suppresses the reveal without overriding them.
# The runtime API cannot un-override a node once written, so suppression is
# refused unless the node already carries an explicit configuration; on
# Omarchy it always does (looknfeel.lua), which makes the saved tuple restore
# it byte-for-byte. Any hyprctl reload clears a runtime override regardless.
#
# The value is saved because the node is global and shared with every other
# special workspace, such as Omarchy's SUPER+S scratchpad.
saved_special_animation=""

# Read the specialWorkspace node. Requiring an explicit override guarantees a
# lossless restore; inherited nodes report placeholder values that cannot be
# written back without turning them into overrides.
read_special_animation() {
  hyprctl -j animations 2>/dev/null | jq -r '
    (.[0] // [])[]
    | select(.name == "specialWorkspace"
      and .enabled == true
      and .overridden == true
      and .speed > 0
      and .style != "")
    | "\(.speed)\t\(.bezier)\t\(.style)"' 2>/dev/null | head -n 1
}

restore_special_animation() {
  local speed bezier style

  [[ -n "$saved_special_animation" ]] || return 0
  IFS=$'\t' read -r speed bezier style <<<"$saved_special_animation"
  saved_special_animation=""
  rm -f "$animation_file" 2>/dev/null || true

  [[ "$speed" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 0
  bezier="$(lua_string "$bezier")" || return 0
  style="$(lua_string "$style")" || return 0
  hyprctl eval "hl.animation({ leaf = \"specialWorkspace\", enabled = true, speed = $speed, bezier = $bezier, style = $style })" >/dev/null 2>&1 || true
}

# A run killed with SIGKILL cannot restore the animations itself. Any marker
# still on disk after a few seconds belongs to such a run, never to a live one.
repair_special_animation() {
  local modified now

  [[ -s "$animation_file" ]] || return 0
  modified="$(stat -c '%Y' "$animation_file" 2>/dev/null)" || return 0
  now="$(date +%s)"
  [[ "$modified" =~ ^[0-9]+$ && "$now" =~ ^[0-9]+$ ]] || return 0
  (( now - modified < 5 )) && return 0

  saved_special_animation="$(cat "$animation_file" 2>/dev/null || true)"
  restore_special_animation
}

suppress_special_animation() {
  local speed bezier style

  [[ -n "$saved_special_animation" ]] && return 0
  # Without an explicitly configured node there is nothing safe to restore
  # afterwards, so leave the compositor alone and accept its native reveal.
  saved_special_animation="$(read_special_animation)"
  [[ -n "$saved_special_animation" ]] || return 0
  IFS=$'\t' read -r speed bezier style <<<"$saved_special_animation"
  bezier="$(lua_string "$bezier")" || { saved_special_animation=""; return 0; }
  style="$(lua_string "$style")" || { saved_special_animation=""; return 0; }

  # Park on disk even though INT/TERM/HUP are trapped: SIGKILL cannot be, and
  # leaving the reveal fast would silently flatten every other special
  # workspace until a reload or until the next run repairs it.
  printf '%s\n' "$saved_special_animation" > "$animation_file" 2>/dev/null || true
  trap restore_special_animation EXIT
  hyprctl eval "hl.animation({ leaf = \"specialWorkspace\", enabled = true, speed = 0.1, bezier = $bezier, style = $style })" >/dev/null 2>&1 || true
}

animation_speed() {
  hyprctl -j animations 2>/dev/null | jq -r --arg name "$1" '
    (.[0] // [])[]
    | select(.name == $name and .overridden == true and .speed > 0)
    | .speed' 2>/dev/null | head -n 1
}

# Hyprland animation speeds are in deciseconds. Used as an upper bound when
# waiting for a window move to finish; the actual wait polls the live window
# position and returns as soon as the destination is reached, so slow user
# configurations are honored rather than cut off by a hard clamp.
move_animation_seconds() {
  local speed leaf

  for leaf in windowsMove windows global; do
    speed="$(animation_speed "$leaf")"
    [[ "$speed" =~ ^[0-9]+([.][0-9]+)?$ ]] && break
    speed=""
  done
  [[ -n "$speed" ]] || speed=4

  awk -v s="$speed" 'BEGIN {
    v = s / 10 + 0.25
    if (v < 0.15) v = 0.15
    printf "%.2f", v
  }'
}

# Poll until the client's top edge sits within 2px of $2 or $3 seconds elapse.
# The compositor applies window moves asynchronously, and the workspace may
# only be toggled once the slide has finished.
wait_window_y() {
  local address="$1" target="$2" timeout="$3"
  local deadline now y

  deadline="$(awk -v n="${EPOCHREALTIME:-0}" -v t="$timeout" 'BEGIN { printf "%.0f", n * 1000000 + t * 1000000 }')"
  while :; do
    y="$(hyprctl clients -j 2>/dev/null | jq -r --arg address "$address" \
      '.[] | select(.address == $address) | .at[1]' | head -n 1)"
    [[ "$y" =~ ^-?[0-9]+$ ]] && (( y > target - 3 && y < target + 3 )) && return 0
    now="${EPOCHREALTIME%%.*}"
    (( now >= deadline )) && return 1
    sleep 0.02
  done
}

compute_geometry_on() {
  # Anchor geometry to $1: a monitor id (clients report .monitor as an id) or
  # a monitor name; empty means the focused monitor.
  local target="$1"
  local mon_json monitor_width monitor_height monitor_scale logical_width logical_height

  # Hyprland coordinates are global across monitors; anchor everything to the
  # target monitor's origin so stacked or side-by-side arrangements park the
  # window just above that monitor rather than toward desktop (0,0). Summoning
  # anchors to the focused monitor, hiding to the monitor the window lives on;
  # guessing wrong lets Hyprland migrate the special workspace mid-animation,
  # which re-centers the floating window visibly on the wrong screen.
  #
  # The whole record is fetched in ONE query: sampling fields individually can
  # straddle a focus change and mix two monitors' origins and dimensions.
  local filter='select(.focused)'
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    filter="select(.id == $target)"
  elif [[ -n "$target" ]]; then
    filter="select(.name == \"$target\")"
  fi
  mon_json="$(hyprctl monitors -j 2>/dev/null | jq -c ".[] | $filter" | head -n 1)"
  [[ -n "$mon_json" ]] || return 1
  monitor_x="$(jq -r '.x // 0' <<<"$mon_json")"
  monitor_y="$(jq -r '.y // 0' <<<"$mon_json")"
  monitor_width="$(jq -r '.width // 1920' <<<"$mon_json")"
  monitor_height="$(jq -r '.height // 1080' <<<"$mon_json")"
  monitor_scale="$(jq -r '.scale // 1' <<<"$mon_json")"
  [[ "$monitor_x" =~ ^-?[0-9]+$ ]] || monitor_x=0
  [[ "$monitor_y" =~ ^-?[0-9]+$ ]] || monitor_y=0
  [[ "$monitor_width" =~ ^[0-9]+$ ]] || monitor_width=1920
  [[ "$monitor_height" =~ ^[0-9]+$ ]] || monitor_height=1080
  [[ "$monitor_scale" =~ ^[0-9]+([.][0-9]+)?$ ]] || monitor_scale=1

  logical_width="$(awk -v width="$monitor_width" -v scale="$monitor_scale" 'BEGIN { if (scale <= 0) scale = 1; printf "%d", width / scale }')"
  logical_height="$(awk -v height="$monitor_height" -v scale="$monitor_scale" 'BEGIN { if (scale <= 0) scale = 1; printf "%d", height / scale }')"
  window_width="$(awk -v width="$logical_width" -v percent="$window_width_percent" 'BEGIN { printf "%d", width * percent / 100 }')"
  window_height="$(awk -v height="$logical_height" -v percent="$window_height_percent" 'BEGIN { printf "%d", height * percent / 100 }')"
  top_margin="$(awk -v height="$logical_height" 'BEGIN { margin = height * 0.04; if (margin < 24) margin = 24; printf "%d", margin }')"
  window_x=$(((logical_width - window_width) / 2))
  top_margin=$(( monitor_y + top_margin ))
  window_x=$(( monitor_x + window_x ))
  parked_y=$(( monitor_y - (window_height + 60) ))
}

compute_geometry() {
  compute_geometry_on ""
}

# Hiding must clear the real window, which the user may have resized by hand,
# so prefer the live geometry over the configured percentages. Geometry is
# anchored to the monitor the window actually lives on: parking relative to
# the focused monitor instead lets Hyprland migrate the special workspace
# across screens mid-hide and re-center the window visibly.
live_geometry() {
  local address="$1"
  local live_x live_height live_monitor

  live_monitor="$(client_monitor "$address")"
  compute_geometry_on "$live_monitor"
  live_x="$(hyprctl clients -j 2>/dev/null | jq -r --arg address "$address" \
    '.[] | select(.address == $address) | .at[0]' | head -n 1)"
  live_height="$(hyprctl clients -j 2>/dev/null | jq -r --arg address "$address" \
    '.[] | select(.address == $address) | .size[1]' | head -n 1)"
  [[ "$live_x" =~ ^-?[0-9]+$ ]] && window_x="$live_x"
  [[ "$live_height" =~ ^[0-9]+$ ]] && parked_y=$(( monitor_y - (live_height + 60) ))
}

size_window() {
  local address="$1"
  local window_lua state floating width height

  window_lua="$(lua_string "address:$address")" || return 1

  # Re-floating and re-resizing an already correct window costs a round trip
  # plus a settling sleep on every summon, which is visible as lag.
  state="$(hyprctl clients -j 2>/dev/null | jq -r --arg address "$address" \
    '.[] | select(.address == $address) | "\(.floating)\t\(.size[0])\t\(.size[1])"' | head -n 1)"
  IFS=$'\t' read -r floating width height <<<"$state"
  if [[ "$floating" == "true" && "$width" == "$window_width" && "$height" == "$window_height" ]]; then
    set_border_color "$address"
    return 0
  fi

  # Resizing before the float transition completes is interpreted as a
  # tiled-window resize, so wait for the client to report floating first.
  ensure_floating "$address" "$window_lua" || true
  hl_dispatch "hl.dsp.window.resize({ x = $window_width, y = $window_height, window = $window_lua })" >/dev/null
  set_border_color "$address"
}

move_window() {
  local window_lua="$1"
  local y="$2"
  hl_dispatch "hl.dsp.window.move({ x = $window_x, y = $y, relative = false, window = $window_lua })" >/dev/null
}

configure_window() {
  local address="$1"
  local window_lua

  window_lua="$(lua_string "address:$address")" || return 1
  compute_geometry
  size_window "$address"
  move_window "$window_lua" "$top_margin"
}

# Hyprland re-centres a floating window whenever its special workspace is
# revealed, and refuses to keep a window whose centre falls outside the
# monitor. Both are defeated by parking the window in the same synchronous Lua
# block as the reveal, with the window masked so the centred frame is never
# shown.
reveal_parked() {
  local window_lua="$1"

  hyprctl eval "
hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"no_anim\", value = 1 }))
hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"opacity\", value = 0 }))
hl.dispatch(hl.dsp.workspace.toggle_special(\"$special_workspace\"))
hl.dispatch(hl.dsp.window.move({ x = $window_x, y = $parked_y, relative = false, window = $window_lua }))
hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"opacity\", value = 1 }))
hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"no_anim\", value = 0 }))
" >/dev/null 2>&1
}

show_window() {
  local address="$1"
  local window_lua

  window_lua="$(lua_string "address:$address")" || return 1

  if [[ "$slide_from_top" != "1" ]]; then
    configure_window "$address"
    hl_dispatch "hl.dsp.workspace.toggle_special(\"$special_workspace\")" >/dev/null
    focus_window "$window_lua"
    return 0
  fi

  compute_geometry
  size_window "$address"
  suppress_special_animation
  reveal_parked "$window_lua"
  move_window "$window_lua" "$top_margin"
  focus_window "$window_lua"
  # Hyprland re-reads the animation config on every tick, so the reveal must be
  # left suppressed until the drop has finished. Restoring immediately lets the
  # workspace resume sliding up underneath the descending window.
  wait_window_y "$address" "$top_margin" "$(move_animation_seconds)" || true
  restore_special_animation
  # Re-assert focus once settled: during a cross-monitor reveal the compositor
  # can drop the initial focus, which would trip the focus-loss auto-hide.
  hl_dispatch "hl.dsp.focus({ window = $window_lua })" >/dev/null
}

hide_window() {
  local address="$1"
  local window_lua

  window_lua="$(lua_string "address:$address")" || return 1

  if [[ "$slide_from_top" != "1" ]]; then
    hl_dispatch "hl.dsp.workspace.toggle_special(\"$special_workspace\")" >/dev/null
    return 0
  fi

  live_geometry "$address"
  # Focus the terminal before touching the workspace: toggle_special acts on
  # whichever monitor holds focus, and focusing another monitor's workspace
  # while the special is open elsewhere makes Hyprland migrate the whole
  # special workspace across screens, flashing the re-centered window.
  focus_window "$window_lua"
  move_window "$window_lua" "$parked_y"
  wait_window_y "$address" "$parked_y" "$(move_animation_seconds)" || true
  hl_dispatch "hl.dsp.workspace.toggle_special(\"$special_workspace\")" >/dev/null
}

# True when the window intersects any connected monitor's rectangle rather
# than sitting parked off-screen. A script killed mid-toggle can leave the
# workspace visible but the window parked; classifying that as "hidden" keeps
# a single keypress recovering it.
#
# An unreadable query also reports on-screen: the hide branch is self-healing
# (a later press recovers either way), while issuing a recovery move against a
# transiently unreadable window would fight whatever animation is in flight.
window_on_screen() {
  local address="$1"
  local rect

  rect="$(hyprctl clients -j 2>/dev/null | jq -c --arg address "$address" \
    '.[] | select(.address == $address) | {x: .at[0], y: .at[1], w: .size[0], h: .size[1]}' | head -n 1)"
  [[ "$rect" == "{"* ]] || return 0
  hyprctl monitors -j 2>/dev/null | jq -e --argjson win "$rect" \
    'any(.[]; (.x < $win.x + $win.w) and ($win.x < .x + .width)
          and (.y < $win.y + $win.h) and ($win.y < .y + .height))' >/dev/null 2>&1
}

client_exists() {
  local address="$1"
  hyprctl clients -j 2>/dev/null \
    | jq -e --arg address "$address" 'any(.[]; .address == $address)' >/dev/null 2>&1
}

client_workspace() {
  local address="$1"
  hyprctl clients -j 2>/dev/null \
    | jq -r --arg address "$address" '.[] | select(.address == $address) | .workspace.name' \
    | head -n 1
}

client_monitor() {
  local address="$1"
  hyprctl clients -j 2>/dev/null \
    | jq -r --arg address "$address" '.[] | select(.address == $address) | .monitor' \
    | head -n 1
}

is_client_address() {
  [[ "$1" =~ ^0x[[:xdigit:]]+$ ]]
}

lua_string() {
  local value="$1"

  # Control characters cannot be represented safely in the inline Lua source.
  [[ "$value" =~ [[:cntrl:]] ]] && return 1
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

workspace_selector() {
  local workspace="$1"
  if [[ "$workspace" =~ ^[0-9]+$ ]]; then
    printf '%s' "$workspace"
  else
    printf 'name:%s' "$workspace"
  fi
}

special_visible() {
  hyprctl monitors -j 2>/dev/null \
    | jq -e --arg special "special:$special_workspace" \
      'any(.[]; .specialWorkspace.name == $special)' >/dev/null 2>&1
}

focus_window() {
  local window_lua="$1"

  # Let a workspace toggle or transfer settle before restoring focus.
  sleep 0.05
  hl_dispatch "hl.dsp.focus({ window = $window_lua })" >/dev/null
}

repair_special_animation

terminal_address="$(cat "$address_file" 2>/dev/null || true)"

# Recover the tracked client after shell restarts. Also migrate a client left
# in the old visible workspace used by earlier plugin versions.
if [[ -z "$terminal_address" ]] || ! client_exists "$terminal_address"; then
  terminal_address="$(hyprctl clients -j 2>/dev/null | jq -r --arg special "special:$special_workspace" \
    '.[] | select(.workspace.name == $special) | .address' | head -n 1)"
fi
if [[ -z "$terminal_address" ]]; then
  terminal_address="$(hyprctl clients -j 2>/dev/null | jq -r \
    '.[] | select(.workspace.name == "dropdown-terminal" or .workspace.name == "dropdown-terminal-hidden") | .address' | head -n 1)"
fi

if [[ -n "$terminal_address" ]] && is_client_address "$terminal_address" && client_exists "$terminal_address"; then
  printf '%s\n' "$terminal_address" > "$address_file"
  terminal_workspace="$(client_workspace "$terminal_address")"
  terminal_window="$(lua_string "address:$terminal_address")" || die "invalid terminal address"

  # Migrate clients created by the pre-special-workspace implementation.
  if [[ "$terminal_workspace" == "$legacy_workspace" || "$terminal_workspace" == "$special_workspace" ]]; then
    hl_dispatch "hl.dsp.window.move({ workspace = \"special:$special_workspace\", follow = false, window = $terminal_window })" >/dev/null
  fi

  if [[ "$action" == "hide" || "$action" == "cleanup" ]]; then
    active_address="$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // ""')"
    # The timer also fires after opening and focusing the dropdown. Ignore that
    # event; this is the tracked terminal rather than a genuine focus loss.
    [[ "$active_address" == "$terminal_address" ]] && exit 0

    # Applications launched from a menu while the terminal has focus inherit
    # its special workspace. Return that newly focused application to the
    # normal focused workspace before hiding the dropdown behind it.
    active_workspace="$(client_workspace "$active_address")"
    active_window=""
    if [[ "$active_workspace" == "special:$special_workspace" ]] && is_client_address "$active_address"; then
      focused_workspace="$(hyprctl monitors -j 2>/dev/null | jq -r \
        '.[] | select(.focused) | .activeWorkspace.name // "1"' | head -n 1)"
      focused_workspace="${focused_workspace:-1}"
      target_workspace="$(workspace_selector "$focused_workspace")"
      target_workspace_lua="$(lua_string "$target_workspace")" || die "invalid workspace name"
      active_window="$(lua_string "address:$active_address")" || die "invalid active window address"
      hl_dispatch "hl.dsp.window.move({ workspace = $target_workspace_lua, follow = false, window = $active_window })" >/dev/null
    fi

    # Cleanup always preserves the normal user's focus behavior. It only acts
    # when a foreign window inherited the dropdown's special workspace.
    if [[ "$action" == "cleanup" && -z "$active_window" ]]; then
      exit 0
    fi

    special_visible || exit 0
    hide_window "$terminal_address"
    if [[ -n "${active_window:-}" ]]; then
      focus_window "$active_window"
    fi
    exit $?
  fi

  # Summoned while shown on another monitor: bring it to the focused one,
  # resized and positioned for that screen. Without this branch the window
  # either hid unexpectedly or migrated through the recovery path below with
  # its original size, which is wrong whenever the screens' scales differ.
  if special_visible && [[ "$action" == "toggle" ]]; then
    term_monitor="$(client_monitor "$terminal_address")"
    focused_id="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .id' | head -n 1)"
    if [[ "$focused_id" =~ ^[0-9]+$ && "$term_monitor" != "$focused_id" ]]; then
      compute_geometry_on "$focused_id"
      size_window "$terminal_address"
      move_window "$terminal_window" "$top_margin"
      focus_window "$terminal_window"
      exit $?
    fi
  fi

  # A second toggle hides the visible special workspace. Do not focus its
  # client afterward: focusing a hidden special-workspace window can reveal it.
  if special_visible && window_on_screen "$terminal_address"; then
    hide_window "$terminal_address"
    exit $?
  fi

  # Recover a workspace left visible with the window still parked off screen.
  if special_visible; then
    compute_geometry
    move_window "$terminal_window" "$top_margin"
    focus_window "$terminal_window"
    exit $?
  fi

  show_window "$terminal_address"
  exit $?
fi

# Focus reconciliation and auto-hide are no-ops until the terminal exists;
# neither background action should create a terminal window.
if [[ "$action" == "hide" || "$action" == "cleanup" ]]; then
  exit 0
fi

before_clients="$(hyprctl clients -j 2>/dev/null | jq -r '.[].address' | sort)"

# Launch through Omarchy so xdg-terminal-exec selects the configured emulator.
# 9>&- keeps the lock fd out of the launched terminal: it must outlive this
# script without holding the lock, or every later invocation would block.
omarchy launch terminal >/dev/null 2>&1 9>&- &

for _ in $(seq 1 40); do
  current="$(hyprctl clients -j 2>/dev/null | jq -r --arg before "$before_clients" '
    .[] | .address as $address
    | select((($before | split("\n")) | index($address)) == null)
    | $address' | head -n 1)"
  current="${current:-0x0}"

  if [[ "$current" != "0x0" ]] && is_client_address "$current"; then
    current_window="$(lua_string "address:$current")" || die "invalid terminal address"
    printf '%s\n' "$current" > "$address_file"
    # Keep first-launch setup invisible while the initial window is moved out
    # of the normal layout and configured at its final geometry. The mask is
    # lifted here rather than inside show_window because the native-slide
    # setting never unmasks; with a top drop, reveal_parked simply re-masks
    # and lifts it at the moment the workspace becomes visible.
    hyprctl eval "hl.dispatch(hl.dsp.window.set_prop({ window = $current_window, prop = \"opacity\", value = 0 }))" >/dev/null 2>&1 || true
    compute_geometry
    size_window "$current"
    move_window "$current_window" "$top_margin"
    hl_dispatch "hl.dsp.window.move({ workspace = \"special:$special_workspace\", follow = false, window = $current_window })" >/dev/null
    hyprctl eval "hl.dispatch(hl.dsp.window.set_prop({ window = $current_window, prop = \"opacity\", value = 1 }))" >/dev/null 2>&1 || true
    show_window "$current"
    exit $?
  fi
  sleep 0.1
done

exit 0
