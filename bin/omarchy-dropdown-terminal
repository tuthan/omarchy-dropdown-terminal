#!/usr/bin/env bash

set -u

special_workspace="dropdown-terminal"
legacy_workspace="dropdown-terminal-hidden"

debug() {
  [[ "${YADTM_DEBUG:-}" == "1" ]] || return 0
  # Deliberately accept only already-classified facts here. Never pass command
  # strings to this function: compositor commands can contain user data.
  printf 'Dropdown Terminal [debug]: %s\n' "$*" >&2
}

die() {
  printf 'Dropdown Terminal: %s\n' "$1" >&2
  exit 1
}

action="${1:-toggle}"
[[ "$action" == "toggle" || "$action" == "hide" || "$action" == "cleanup" || "$action" == "status" || "$action" == "state-root" ]] || die "unknown action: $action"

window_width_percent="${2:-90}"
window_height_percent="${3:-45}"
border_color="${4:-theme}"
slide_from_top="${5:-1}"

[[ "$window_width_percent" =~ ^[0-9]+$ ]] || window_width_percent=90
[[ "$window_height_percent" =~ ^[0-9]+$ ]] || window_height_percent=45
(( window_width_percent = window_width_percent < 20 ? 20 : window_width_percent > 100 ? 100 : window_width_percent ))
(( window_height_percent = window_height_percent < 20 ? 20 : window_height_percent > 100 ? 100 : window_height_percent ))

if [[ "$border_color" != "theme" && ! "$border_color" =~ ^(rgb|rgba)\([[:xdigit:]]+\)$ ]]; then
  border_color="theme"
fi

[[ "$slide_from_top" == "0" || "$slide_from_top" == "1" ]] || slide_from_top=1

# Geometry computed by compute_geometry / live_geometry. Coordinates are
# global desktop coordinates, anchored at the focused monitor's origin.
window_width=0
window_height=0
window_x=0
top_margin=0
parked_y=0
monitor_x=0
monitor_y=0

is_private_dir() {
  local dir="$1"
  local mode

  [[ -d "$dir" && ! -L "$dir" && -O "$dir" ]] || return 1
  mode="$(stat -c '%a' "$dir" 2>/dev/null)" || return 1
  (( (8#$mode & 077) == 0 ))
}

state_dir() {
  local dir="${XDG_RUNTIME_DIR:-}"
  local old_umask

  if [[ -n "$dir" ]] && is_private_dir "$dir"; then
    printf '%s\n' "$dir"
    return
  fi

  dir="/tmp/omarchy-dropdown-terminal-${UID:-$(id -u)}"
  if [[ -e "$dir" || -L "$dir" ]]; then
    is_private_dir "$dir" || die "refusing insecure state directory: $dir"
  else
    old_umask="$(umask)"
    umask 077
    if ! mkdir "$dir" 2>/dev/null; then
      [[ -d "$dir" ]] || { umask "$old_umask"; die "could not create state directory: $dir"; }
    fi
    umask "$old_umask"
  fi

  chmod 700 "$dir" 2>/dev/null || true
  is_private_dir "$dir" || die "state directory is not private: $dir"
  printf '%s\n' "$dir"
}

state_root="$(state_dir)" || exit $?
state_file="$state_root/io.github.tuthan.dropdown-terminal.state.json"
legacy_address_file="$state_root/address"
animation_file="$state_root/io.github.tuthan.dropdown-terminal.special-animation"
legacy_animation_file="$state_root/special-animation"
launch_file="$state_root/io.github.tuthan.dropdown-terminal.launch"
event_file="$state_root/io.github.tuthan.dropdown-terminal.events"

debug "action=$action"

# Lifecycle events are written only after the corresponding compositor action
# returns successfully. They are deliberately short, tab-separated facts:
# command text never enters this journal, the state file, or debug output.
record_lifecycle() {
  local phase="$1" address="$2" transition_id timestamp
  case "$phase" in
    shown|hidden|closed) ;;
    *) return 1 ;;
  esac
  is_client_address "$address" || return 1
  transition_id="helper-${BASHPID:-$$}-${EPOCHREALTIME:-0}"
  timestamp="${EPOCHREALTIME:-0}"
  printf 'v1\t%s\thelper\t%s\t%s\t%s\n' "$phase" "$transition_id" "$timestamp" "$address" \
    >>"$event_file" 2>/dev/null || return 1
  debug "lifecycle phase=$phase"
}

hl_dispatch() {
  hyprctl eval "hl.dispatch($1)"
}

ensure_floating() {
  local address="$1"
  local window_lua="$2"
  local floating
  local attempt

  # Hyprland applies float asynchronously, and ignores it entirely for windows
  # on hidden workspaces. Retry until the client reports floating.
  for attempt in $(seq 1 6); do
    hl_dispatch "hl.dsp.window.float({ action = \"set\", window = $window_lua })" >/dev/null
    sleep 0.1
    floating="$(hyprctl clients -j 2>/dev/null | jq -r --arg address "$address" \
      '.[] | select(.address == $address) | .floating' | head -n 1)"
    [[ "$floating" == "true" ]] && return 0
  done
  return 1
}

set_border_color() {
  local address="$1"
  local window_lua color_lua

  window_lua="$(lua_string "address:$address")" || return 1
  if [[ "$border_color" == "theme" ]]; then
    color_lua='"default"'
  else
    color_lua="$(lua_string "$border_color")" || return 1
  fi

  hyprctl eval "hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"active_border_color\", value = $color_lua }))" >/dev/null 2>&1 || true
  hyprctl eval "hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"inactive_border_color\", value = $color_lua }))" >/dev/null 2>&1 || true
}

# Hyprland has no per-workspace animation control and no way to reverse the
# direction of a "slidevert" special workspace, so the reveal is made instant
# and the visible motion is driven by an animated window move instead.
#
# Only the specialWorkspace parent node is touched: specialWorkspaceIn and
# specialWorkspaceOut keep their own enabled flags but resolve their speed,
# bezier, and style through the tree at use time (verified on Hyprland
# 0.56.2), so a fast parent suppresses the reveal without overriding them.
# The runtime API cannot un-override a node once written, so suppression is
# refused unless the node already carries an explicit configuration; on
# Omarchy it always does (looknfeel.lua), which makes the saved tuple restore
# it byte-for-byte. Any hyprctl reload clears a runtime override regardless.
#
# The value is saved because the node is global and shared with every other
# special workspace, such as Omarchy's SUPER+S scratchpad.
saved_special_animation=""

# Read the specialWorkspace node. Requiring an explicit override guarantees a
# lossless restore; inherited nodes report placeholder values that cannot be
# written back without turning them into overrides.
read_special_animation() {
  hyprctl -j animations 2>/dev/null | jq -r '
    (.[0] // [])[]
    | select(.name == "specialWorkspace"
      and .enabled == true
      and .overridden == true
      and .speed > 0
      and .style != "")
    | "\(.speed)\t\(.bezier)\t\(.style)"' 2>/dev/null | head -n 1
}

restore_special_animation() {
  local speed bezier style

  [[ -n "$saved_special_animation" ]] || return 0
  IFS=$'\t' read -r speed bezier style <<<"$saved_special_animation"
  saved_special_animation=""
  rm -f "$animation_file" 2>/dev/null || true
  rm -f "$legacy_animation_file" 2>/dev/null || true
  debug "animation restore speed=$speed style=$style"

  [[ "$speed" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 0
  bezier="$(lua_string "$bezier")" || return 0
  style="$(lua_string "$style")" || return 0
  hyprctl eval "hl.animation({ leaf = \"specialWorkspace\", enabled = true, speed = $speed, bezier = $bezier, style = $style })" >/dev/null 2>&1 || true
}

# A run killed with SIGKILL cannot restore the animations itself. Any marker
# still on disk after a few seconds belongs to such a run, never to a live one.
repair_special_animation() {
  local marker="$animation_file"
  [[ -s "$marker" ]] || marker="$legacy_animation_file"
  [[ -s "$marker" ]] || return 0

  saved_special_animation="$(cat "$marker" 2>/dev/null || true)"
  debug "animation repair marker=$marker"
  restore_special_animation
}

suppress_special_animation() {
  local speed bezier style

  [[ -n "$saved_special_animation" ]] && return 0
  # Without an explicitly configured node there is nothing safe to restore
  # afterwards, so leave the compositor alone and accept its native reveal.
  saved_special_animation="$(read_special_animation)"
  [[ -n "$saved_special_animation" ]] || return 0
  IFS=$'\t' read -r speed bezier style <<<"$saved_special_animation"
  bezier="$(lua_string "$bezier")" || { saved_special_animation=""; return 0; }
  style="$(lua_string "$style")" || { saved_special_animation=""; return 0; }

  # Park on disk even though INT/TERM/HUP are trapped: SIGKILL cannot be, and
  # leaving the reveal fast would silently flatten every other special
  # workspace until a reload or until the next run repairs it.
  printf '%s\n' "$saved_special_animation" > "$animation_file" 2>/dev/null || true
  debug "animation snapshot=stored"
  trap restore_special_animation EXIT
  hyprctl eval "hl.animation({ leaf = \"specialWorkspace\", enabled = true, speed = 0.1, bezier = $bezier, style = $style })" >/dev/null 2>&1 || true
}

animation_speed() {
  hyprctl -j animations 2>/dev/null | jq -r --arg name "$1" '
    (.[0] // [])[]
    | select(.name == $name and .overridden == true and .speed > 0)
    | .speed' 2>/dev/null | head -n 1
}

# Hyprland animation speeds are in deciseconds. Used as an upper bound when
# waiting for a window move to finish; the actual wait polls the live window
# position and returns as soon as the destination is reached, so slow user
# configurations are honored rather than cut off by a hard clamp.
move_animation_seconds() {
  local speed leaf

  for leaf in windowsMove windows global; do
    speed="$(animation_speed "$leaf")"
    [[ "$speed" =~ ^[0-9]+([.][0-9]+)?$ ]] && break
    speed=""
  done
  [[ -n "$speed" ]] || speed=4

  awk -v s="$speed" 'BEGIN {
    v = s / 10 + 0.25
    if (v < 0.15) v = 0.15
    printf "%.2f", v
  }'
}

# Poll until the client's top edge sits within 2px of $2 or $3 seconds elapse.
# The compositor applies window moves asynchronously, and the workspace may
# only be toggled once the slide has finished.
wait_window_y() {
  local address="$1" target="$2" timeout="$3"
  local attempts y i

  # The sleep already defines the sampling unit. A bounded iteration count
  # avoids clock-unit mistakes and makes the lifecycle finite even when the
  # compositor refuses a move.
  attempts="$(awk -v t="$timeout" 'BEGIN { n = int((t / 0.02) + 1); if (n < 1) n = 1; print n }')"
  for ((i = 0; i < attempts; i++)); do
    client_exists "$address" || {
      debug "wait address=$address result=client-missing"
      return 1
    }
    y="$(hyprctl clients -j 2>/dev/null | jq -r --arg address "$address" \
      '.[] | select(.address == $address) | .at[1]' | head -n 1)"
    if [[ "$y" =~ ^-?[0-9]+$ ]] && (( y > target - 3 && y < target + 3 )); then
      debug "wait address=$address target=$target result=reached"
      return 0
    fi
    sleep 0.02
  done
  debug "wait address=$address target=$target result=timeout"
  return 1
}

compute_geometry_on() {
  # Anchor geometry to $1: a monitor id (clients report .monitor as an id) or
  # a monitor name; empty means the focused monitor.
  local target="$1"
  local mon_json monitor_width monitor_height monitor_scale logical_width logical_height

  # Hyprland coordinates are global across monitors; anchor everything to the
  # target monitor's origin so stacked or side-by-side arrangements park the
  # window just above that monitor rather than toward desktop (0,0). Summoning
  # anchors to the focused monitor, hiding to the monitor the window lives on;
  # guessing wrong lets Hyprland migrate the special workspace mid-animation,
  # which re-centers the floating window visibly on the wrong screen.
  #
  # The whole record is fetched in ONE query: sampling fields individually can
  # straddle a focus change and mix two monitors' origins and dimensions.
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    mon_json="$(hyprctl monitors -j 2>/dev/null | jq -c --argjson target "$target" \
      '.[] | select(.id == $target)' | head -n 1)"
  elif [[ -n "$target" ]]; then
    mon_json="$(hyprctl monitors -j 2>/dev/null | jq -c --arg target "$target" \
      '.[] | select(.name == $target)' | head -n 1)"
  else
    mon_json="$(hyprctl monitors -j 2>/dev/null | jq -c '.[] | select(.focused)' | head -n 1)"
  fi
  [[ -n "$mon_json" ]] || return 1
  monitor_x="$(jq -r '.x // 0' <<<"$mon_json")"
  monitor_y="$(jq -r '.y // 0' <<<"$mon_json")"
  monitor_width="$(jq -r '.width // 1920' <<<"$mon_json")"
  monitor_height="$(jq -r '.height // 1080' <<<"$mon_json")"
  monitor_scale="$(jq -r '.scale // 1' <<<"$mon_json")"
  [[ "$monitor_x" =~ ^-?[0-9]+$ ]] || monitor_x=0
  [[ "$monitor_y" =~ ^-?[0-9]+$ ]] || monitor_y=0
  [[ "$monitor_width" =~ ^[0-9]+$ ]] || monitor_width=1920
  [[ "$monitor_height" =~ ^[0-9]+$ ]] || monitor_height=1080
  [[ "$monitor_scale" =~ ^[0-9]+([.][0-9]+)?$ ]] || monitor_scale=1

  logical_width="$(awk -v width="$monitor_width" -v scale="$monitor_scale" 'BEGIN { if (scale <= 0) scale = 1; printf "%d", width / scale }')"
  logical_height="$(awk -v height="$monitor_height" -v scale="$monitor_scale" 'BEGIN { if (scale <= 0) scale = 1; printf "%d", height / scale }')"
  window_width="$(awk -v width="$logical_width" -v percent="$window_width_percent" 'BEGIN { printf "%d", width * percent / 100 }')"
  window_height="$(awk -v height="$logical_height" -v percent="$window_height_percent" 'BEGIN { printf "%d", height * percent / 100 }')"
  top_margin="$(awk -v height="$logical_height" 'BEGIN { margin = height * 0.04; if (margin < 24) margin = 24; printf "%d", margin }')"
  window_x=$(((logical_width - window_width) / 2))
  top_margin=$(( monitor_y + top_margin ))
  window_x=$(( monitor_x + window_x ))
  parked_y=$(( monitor_y - (window_height + 60) ))
  debug "geometry monitor=$target x=$window_x y=$top_margin width=$window_width height=$window_height parkedY=$parked_y"
}

compute_geometry() {
  compute_geometry_on ""
}

# Hiding must clear the real window, which the user may have resized by hand,
# so prefer the live geometry over the configured percentages. Geometry is
# anchored to the monitor the window actually lives on: parking relative to
# the focused monitor instead lets Hyprland migrate the special workspace
# across screens mid-hide and re-center the window visibly.
live_geometry() {
  local address="$1"
  local live_x live_height live_monitor

  live_monitor="$(client_monitor "$address")"
  compute_geometry_on "$live_monitor"
  live_x="$(hyprctl clients -j 2>/dev/null | jq -r --arg address "$address" \
    '.[] | select(.address == $address) | .at[0]' | head -n 1)"
  live_height="$(hyprctl clients -j 2>/dev/null | jq -r --arg address "$address" \
    '.[] | select(.address == $address) | .size[1]' | head -n 1)"
  [[ "$live_x" =~ ^-?[0-9]+$ ]] && window_x="$live_x"
  [[ "$live_height" =~ ^[0-9]+$ ]] && parked_y=$(( monitor_y - (live_height + 60) ))
}

size_window() {
  local address="$1"
  local window_lua state floating width height

  window_lua="$(lua_string "address:$address")" || return 1

  # Re-floating and re-resizing an already correct window costs a round trip
  # plus a settling sleep on every summon, which is visible as lag.
  state="$(hyprctl clients -j 2>/dev/null | jq -r --arg address "$address" \
    '.[] | select(.address == $address) | "\(.floating)\t\(.size[0])\t\(.size[1])"' | head -n 1)"
  IFS=$'\t' read -r floating width height <<<"$state"
  if [[ "$floating" == "true" && "$width" == "$window_width" && "$height" == "$window_height" ]]; then
    set_border_color "$address"
    return 0
  fi

  # Resizing before the float transition completes is interpreted as a
  # tiled-window resize, so wait for the client to report floating first.
  ensure_floating "$address" "$window_lua" || true
  hl_dispatch "hl.dsp.window.resize({ x = $window_width, y = $window_height, window = $window_lua })" >/dev/null
  set_border_color "$address"
}

move_window() {
  local window_lua="$1"
  local y="$2"
  hl_dispatch "hl.dsp.window.move({ x = $window_x, y = $y, relative = false, window = $window_lua })" >/dev/null
}

configure_window() {
  local address="$1"
  local window_lua

  window_lua="$(lua_string "address:$address")" || return 1
  compute_geometry
  size_window "$address"
  move_window "$window_lua" "$top_margin"
}

# Hyprland re-centres a floating window whenever its special workspace is
# revealed, and refuses to keep a window whose centre falls outside the
# monitor. Both are defeated by parking the window in the same synchronous Lua
# block as the reveal, with the window masked so the centred frame is never
# shown.
reveal_parked() {
  local window_lua="$1"

  hyprctl eval "
hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"no_anim\", value = 1 }))
hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"opacity\", value = 0 }))
hl.dispatch(hl.dsp.workspace.toggle_special(\"$special_workspace\"))
hl.dispatch(hl.dsp.window.move({ x = $window_x, y = $parked_y, relative = false, window = $window_lua }))
hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"opacity\", value = 1 }))
hl.dispatch(hl.dsp.window.set_prop({ window = $window_lua, prop = \"no_anim\", value = 0 }))
" >/dev/null 2>&1
}

show_window() {
  local address="$1"
  local window_lua

  window_lua="$(lua_string "address:$address")" || return 1

  if [[ "$slide_from_top" != "1" ]]; then
    configure_window "$address"
    hl_dispatch "hl.dsp.workspace.toggle_special(\"$special_workspace\")" >/dev/null
    focus_window "$window_lua"
    return 0
  fi

  compute_geometry
  size_window "$address"
  suppress_special_animation
  reveal_parked "$window_lua"
  move_window "$window_lua" "$top_margin"
  focus_window "$window_lua"
  # Hyprland re-reads the animation config on every tick, so the reveal must be
  # left suppressed until the drop has finished. Restoring immediately lets the
  # workspace resume sliding up underneath the descending window.
  wait_window_y "$address" "$top_margin" "$(move_animation_seconds)" || true
  restore_special_animation
  # Re-assert focus once settled: during a cross-monitor reveal the compositor
  # can drop the initial focus, which would trip the focus-loss auto-hide.
  hl_dispatch "hl.dsp.focus({ window = $window_lua })" >/dev/null
}

hide_window() {
  local address="$1"
  local window_lua

  window_lua="$(lua_string "address:$address")" || return 1

  if [[ "$slide_from_top" != "1" ]]; then
    hl_dispatch "hl.dsp.workspace.toggle_special(\"$special_workspace\")" >/dev/null
    return 0
  fi

  live_geometry "$address"
  # Focus the terminal before touching the workspace: toggle_special acts on
  # whichever monitor holds focus, and focusing another monitor's workspace
  # while the special is open elsewhere makes Hyprland migrate the whole
  # special workspace across screens, flashing the re-centered window.
  focus_window "$window_lua"
  move_window "$window_lua" "$parked_y"
  wait_window_y "$address" "$parked_y" "$(move_animation_seconds)" || true
  hl_dispatch "hl.dsp.workspace.toggle_special(\"$special_workspace\")" >/dev/null
}

# True when the window intersects its owner monitor's rectangle rather than
# sitting parked off-screen. Testing every output is wrong for vertically
# stacked layouts: a parked rectangle can overlap a neighbour while still
# being parked for the monitor that owns the client.
#
# An unreadable query also reports on-screen: the hide branch is self-healing
# (a later press recovers either way), while issuing a recovery move against a
# transiently unreadable window would fight whatever animation is in flight.
window_on_screen() {
  local address="$1"
  local rect owner_monitor

  rect="$(hyprctl clients -j 2>/dev/null | jq -c --arg address "$address" \
    '.[] | select(.address == $address) | {x: .at[0], y: .at[1], w: .size[0], h: .size[1]}' | head -n 1)"
  [[ "$rect" == "{"* ]] || return 0
  owner_monitor="$(client_monitor "$address")"
  [[ "$owner_monitor" =~ ^[0-9]+$ ]] || return 0
  hyprctl monitors -j 2>/dev/null | jq -e --argjson win "$rect" --argjson owner "$owner_monitor" \
    'any(.[]; .id == $owner and (.x < $win.x + $win.w) and ($win.x < .x + .width)
          and (.y < $win.y + $win.h) and ($win.y < .y + .height))' >/dev/null 2>&1
}

client_exists() {
  local address="$1"
  hyprctl clients -j 2>/dev/null \
    | jq -e --arg address "$address" 'any(.[]; .address == $address)' >/dev/null 2>&1
}

client_workspace() {
  local address="$1"
  hyprctl clients -j 2>/dev/null \
    | jq -r --arg address "$address" '.[] | select(.address == $address) | .workspace.name' \
    | head -n 1
}

client_monitor() {
  local address="$1"
  hyprctl clients -j 2>/dev/null \
    | jq -r --arg address "$address" '.[] | select(.address == $address) | .monitor' \
    | head -n 1
}

state_clients=()
state_active=""
legacy_migration=0

append_unique() {
  local value="$1"
  local existing
  [[ -n "$value" ]] || return 0
  for existing in "${state_clients[@]:-}"; do
    [[ "$existing" == "$value" ]] && return 0
  done
  state_clients+=("$value")
}

read_state() {
  state_clients=()
  state_active=""
  legacy_migration=0

  if [[ -f "$state_file" ]]; then
    # A missing, malformed, or future-version document is deliberately treated
    # as a cache miss. The compositor recovery scan below remains authoritative.
    if jq -e 'type == "object" and .version == 1 and (.clients | type) == "array"' \
      "$state_file" >/dev/null 2>&1; then
      while IFS= read -r candidate; do
        is_client_address "$candidate" && append_unique "$candidate"
      done < <(jq -r '.clients[]? | strings' "$state_file" 2>/dev/null)
      state_active="$(jq -r 'if (.active | type) == "string" then .active else "" end' \
        "$state_file" 2>/dev/null || true)"
    fi
  fi
  # An interrupted upgrade can leave both a broken new file and the old
  # address. Treat the legacy handle as another recovery hint; it is removed
  # only after a valid new document has been published.
  if [[ -f "$legacy_address_file" && ${#state_clients[@]} -eq 0 ]]; then
    legacy_migration=1
    candidate="$(head -n 1 "$legacy_address_file" 2>/dev/null || true)"
    is_client_address "$candidate" && state_clients+=("$candidate")
    state_active="$candidate"
  fi
}

write_state() {
  local active="$1"
  shift
  local temp clients_json now
  local -a clients=("$@")

  if (( ${#clients[@]} == 0 )); then
    clients_json='[]'
  else
    clients_json="$(printf '%s\n' "${clients[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" || return 1
  fi
  now="$(date +%s)" || return 1
  temp="$(mktemp "$state_root/.io.github.tuthan.dropdown-terminal.state.XXXXXX")" || return 1
  if ! jq -cn --argjson clients "$clients_json" --arg active "$active" --argjson now "$now" \
    '{version: 1, clients: $clients, active: (if $active == "" then null else $active end), updatedAt: $now}' \
    > "$temp"; then
    rm -f "$temp"
    return 1
  fi
  chmod 600 "$temp" 2>/dev/null || true
  if ! mv -f "$temp" "$state_file"; then
    rm -f "$temp"
    return 1
  fi
  debug "state active=$active clients=${#clients[@]}"
  return 0
}

recover_clients() {
  recovery_clients=()
  while IFS= read -r candidate; do
    is_client_address "$candidate" || continue
    append_recovery_unique "$candidate"
  done < <(hyprctl clients -j 2>/dev/null | jq -r --arg special "special:$special_workspace" \
    '.[] | select(.workspace.name == $special) | .address' 2>/dev/null)
  while IFS= read -r candidate; do
    is_client_address "$candidate" || continue
    append_recovery_unique "$candidate"
  done < <(hyprctl clients -j 2>/dev/null | jq -r \
    '.[] | select(.workspace.name == "dropdown-terminal" or .workspace.name == "dropdown-terminal-hidden") | .address' 2>/dev/null)
}

append_recovery_unique() {
  local value="$1"
  local existing
  for existing in "${recovery_clients[@]:-}"; do
    [[ "$existing" == "$value" ]] && return 0
  done
  recovery_clients+=("$value")
}

choose_terminal_address() {
  local candidate
  terminal_address=""
  # Prefer the active cached client, then other cached clients, then the full
  # compositor recovery list. No recovery path uses head -n 1: the array shape
  # is intentionally ready for the multi-client phase.
  if is_client_address "$state_active" && client_exists "$state_active"; then
    terminal_address="$state_active"
  else
    for candidate in "${state_clients[@]:-}"; do
      if is_client_address "$candidate" && client_exists "$candidate"; then
        terminal_address="$candidate"
        break
      fi
    done
  fi
  if [[ -z "$terminal_address" ]]; then
    recover_clients
    for candidate in "${recovery_clients[@]:-}"; do
      if client_exists "$candidate"; then
        terminal_address="$candidate"
        break
      fi
    done
  fi
}

is_client_address() {
  [[ "$1" =~ ^0x[[:xdigit:]]+$ ]]
}

lua_string() {
  local value="$1"

  # Control characters cannot be represented safely in the inline Lua source.
  [[ "$value" =~ [[:cntrl:]] ]] && return 1
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

workspace_selector() {
  local workspace="$1"
  if [[ "$workspace" =~ ^[0-9]+$ ]]; then
    printf '%s' "$workspace"
  else
    printf 'name:%s' "$workspace"
  fi
}

special_visible() {
  hyprctl monitors -j 2>/dev/null \
    | jq -e --arg special "special:$special_workspace" \
      'any(.[]; .specialWorkspace.name == $special)' >/dev/null 2>&1
}

client_record() {
  local address="$1"
  hyprctl clients -j 2>/dev/null | jq -c --arg address "$address" \
    '.[] | select(.address == $address)' | head -n 1
}

emit_status() {
  local record active monitor_json visible focused x y width height clients_json candidate existing
  local -a candidates=()
  local -a live_clients=()

  read_state
  if is_client_address "$state_active"; then candidates+=("$state_active"); fi
  for candidate in "${state_clients[@]:-}"; do candidates+=("$candidate"); done
  recover_clients
  for candidate in "${recovery_clients[@]:-}"; do candidates+=("$candidate"); done

  for candidate in "${candidates[@]:-}"; do
    if is_client_address "$candidate" && client_exists "$candidate"; then
      for existing in "${live_clients[@]:-}"; do
        [[ "$existing" == "$candidate" ]] && continue 2
      done
      live_clients+=("$candidate")
    fi
  done

  active=""
  for candidate in "${candidates[@]:-}"; do
    if is_client_address "$candidate" && client_exists "$candidate"; then
      active="$candidate"
      break
    fi
  done
  if [[ -n "$active" ]]; then
    clients_json="$(printf '%s\n' "${live_clients[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
    record="$(client_record "$active")"
  else
    clients_json='[]'
    record=''
  fi

  monitor_json=null
  x=null
  y=null
  width=null
  height=null
  if [[ "$record" == "{"* ]]; then
    monitor_json="$(jq -c '.monitor // null' <<<"$record")"
    x="$(jq -c '.at[0] // null' <<<"$record")"
    y="$(jq -c '.at[1] // null' <<<"$record")"
    width="$(jq -c '.size[0] // null' <<<"$record")"
    height="$(jq -c '.size[1] // null' <<<"$record")"
  fi
  visible=false
  special_visible && visible=true
  focused=false
  if [[ -n "$active" ]] && [[ "$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // ""')" == "$active" ]]; then
    focused=true
  fi

  jq -cn --argjson clients "$clients_json" --arg active "$active" \
    --argjson monitor "$monitor_json" --argjson visible "$visible" --argjson focused "$focused" \
    --argjson x "$x" --argjson y "$y" --argjson width "$width" --argjson height "$height" \
    '{version: 1, clients: $clients, active: (if $active == "" then null else $active end),
      monitor: $monitor, visible: $visible, focused: $focused, x: $x, y: $y,
      width: $width, height: $height}'
}

launch_pids=""
launch_pid=""
pending_before=""
launch_marker_max_age=30

collect_descendant_pids() {
  local parent="$1" child
  [[ "$parent" =~ ^[0-9]+$ ]] || return 0
  [[ -d "/proc/$parent" ]] || return 0
  printf '%s\n' "$parent"
  command -v pgrep >/dev/null 2>&1 || return 0
  while IFS= read -r child; do
    [[ "$child" =~ ^[0-9]+$ ]] || continue
    collect_descendant_pids "$child"
  done < <(pgrep -P "$parent" 2>/dev/null || true)
}

append_launch_pid() {
  local pid="$1" existing
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  while IFS= read -r existing; do
    [[ "$existing" == "$pid" ]] && return 0
  done <<<"$launch_pids"
  launch_pids="${launch_pids:+$launch_pids$'\n'}$pid"
}

observe_launch_pids() {
  local pid
  [[ "$1" =~ ^[0-9]+$ ]] || return 0
  # Keep the launcher itself even if it exits between the background fork and
  # the first /proc traversal; a directly mapped client may carry this PID.
  append_launch_pid "$1"
  while IFS= read -r pid; do
    append_launch_pid "$pid"
  done < <(collect_descendant_pids "$1")
}

new_client_from_json() {
  local clients_json="$1" before="$2" known_pids="$3"
  jq -r --arg before "$before" --arg known "$known_pids" '
    ($known | split("\n")) as $known_pids
    | [ .[]
        | select(.address != null)
        | .address as $address
        | select((($before | split("\n")) | index($address)) == null)
        | .pid as $pid
        | select(($known_pids | index(($pid | tostring))) != null)
      ]
    | sort_by(.pid)
    | .[0].address // empty' <<<"$clients_json"
}

new_client_from() {
  local before="$1" known_pids="${2:-${launch_pids:-}}" clients_json
  clients_json="$(hyprctl clients -j 2>/dev/null)" || return 1
  new_client_from_json "$clients_json" "$before" "$known_pids"
}

poll_new_client() {
  local before="$1" launcher_pid="${2:-}" known_pids="${3:-${launch_pids:-}}"
  local current i previous_pids
  launch_pids="$known_pids"
  for ((i = 0; i < 40; i++)); do
    previous_pids="$launch_pids"
    observe_launch_pids "$launcher_pid"
    if [[ "$launch_pids" != "$previous_pids" ]]; then
      write_launch_marker "$before" "$launcher_pid" "$launch_pids" || true
    fi
    current="$(new_client_from "$before" "$launch_pids")"
    if is_client_address "$current"; then
      printf '%s\n' "$current"
      return 0
    fi
    sleep 0.1
  done
  return 1
}

write_launch_marker() {
  local before="$1" launcher_pid="${2:-}" pids="${3:-}" temp before_json pids_json started
  before_json="$(printf '%s\n' "$before" | jq -Rsc 'split("\n") | map(select(length > 0))')" || return 1
  pids_json="$(printf '%s\n' "$pids" | jq -Rsc 'split("\n") | map(select(length > 0 and test("^[0-9]+$")))')" || return 1
  started="$(date +%s)" || return 1
  temp="$(mktemp "$state_root/.io.github.tuthan.dropdown-terminal.launch.XXXXXX")" || return 1
  if ! jq -cn --argjson before "$before_json" --argjson pids "$pids_json" \
    --arg launcherPid "$launcher_pid" --argjson startedAt "$started" \
    '{version: 1, startedAt: $startedAt,
      launcherPid: (if $launcherPid == "" then null else ($launcherPid | tonumber) end),
      launcherPids: $pids, before: $before}' > "$temp"; then
    rm -f "$temp"
    return 1
  fi
  chmod 600 "$temp" 2>/dev/null || true
  if ! mv -f "$temp" "$launch_file"; then
    rm -f "$temp"
    return 1
  fi
  debug "launch marker=stored"
}

pending_launch_before() {
  [[ -s "$launch_file" ]] || return 1
  if jq -e 'type == "object" and .version == 1 and (.before | type) == "array"' \
    "$launch_file" >/dev/null 2>&1; then
    launch_started="$(jq -r '.startedAt // 0' "$launch_file" 2>/dev/null || true)"
    launch_pid="$(jq -r '.launcherPid // empty' "$launch_file" 2>/dev/null || true)"
    launch_pids="$(jq -r '.launcherPids[]? | strings' "$launch_file" 2>/dev/null || true)"
    # The marker is the durable link between the launcher process tree and a
    # client that maps after this helper's initial polling window. Its age is
    # checked separately so a failed launch cannot wedge every future toggle.
    pending_before="$(jq -r '.before[]? | strings' "$launch_file" 2>/dev/null || true)"
    return 0
  fi

  # Read the pre-1.4 marker format once so an interrupted upgrade can still be
  # adopted safely. It has no process lineage, therefore it will not adopt an
  # unrelated new client.
  launch_started="$(head -n 1 "$launch_file" 2>/dev/null || true)"
  [[ "$launch_started" =~ ^[0-9]+$ ]] || return 1
  launch_pid=""
  launch_pids=""
  pending_before="$(tail -n +2 "$launch_file" 2>/dev/null || true)"
}

launch_marker_stale() {
  local now
  # A malformed or missing timestamp cannot safely identify a delayed launch.
  [[ "${launch_started:-}" =~ ^[0-9]+$ ]] || return 0
  now="$(date +%s 2>/dev/null)" || return 1
  (( now >= launch_started && now - launch_started > launch_marker_max_age ))
}

# Tests source this file to exercise the pure geometry, state, and escaping
# helpers without contacting a compositor. Normal invocations always continue
# into the action dispatcher below.
if [[ "${YADTM_LIB_ONLY:-0}" == "1" ]]; then
  if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
  fi
  exit 0
fi

focus_window() {
  local window_lua="$1"

  # Let a workspace toggle or transfer settle before restoring focus.
  sleep 0.05
  hl_dispatch "hl.dsp.focus({ window = $window_lua })" >/dev/null
}

# `status` is intentionally outside the lock and before repair. It is a
# diagnostic snapshot, so it must neither wait for an animation nor restore
# global compositor state as a side effect.
if [[ "$action" == "state-root" ]]; then
  printf '%s\n' "$state_root"
  exit 0
fi

if [[ "$action" == "status" ]]; then
  emit_status
  exit 0
fi

# Serialize every mutating invocation behind one lock: overlapping runs would
# otherwise snapshot the animation config mid-suppression and later restore
# the suppressed values. Toggle is a drop-on-duplicate action; reconciliation
# actions queue briefly. A failed descriptor open is an infrastructure error,
# not a held lock, and must be reported distinctly.
lock_file="$state_root/io.github.tuthan.dropdown-terminal.lock"
if ! exec 9>"$lock_file" 2>/dev/null; then
  die "could not open lock file: $lock_file"
fi
if [[ "$action" == "toggle" ]]; then
  flock -n 9
  lock_result=$?
  if (( lock_result == 1 )); then
    debug "lock action=$action result=duplicate"
    exit 0
  elif (( lock_result != 0 )); then
    die "could not acquire lock (flock error $lock_result)"
  fi
else
  flock -w 3 9
  lock_result=$?
  if (( lock_result != 0 )); then
    if (( lock_result == 1 )); then
      die "timed out waiting for dropdown terminal lock"
    fi
    die "could not acquire lock (flock error $lock_result)"
  fi
fi
debug "lock action=$action result=acquired"

# Terminating signals must not resume execution after the handler; exiting
# with the conventional code runs the EXIT restoration path armed by
# suppress_special_animation, or nothing when suppression was never engaged.
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

repair_special_animation

read_state
recover_clients=()
choose_terminal_address
debug "recovery active=${terminal_address:-none} cached=${#state_clients[@]}"

if [[ -n "$terminal_address" ]] && is_client_address "$terminal_address" && client_exists "$terminal_address"; then
  if ! write_state "$terminal_address" "$terminal_address"; then
    die "could not publish terminal state"
  fi
  # Retire the legacy address only after the versioned document is safely in
  # place. Keeping this branch for one release makes interrupted upgrades
  # recoverable.
  if (( legacy_migration )); then
    rm -f "$legacy_address_file" 2>/dev/null || true
    legacy_migration=0
  fi
  terminal_workspace="$(client_workspace "$terminal_address")"
  terminal_window="$(lua_string "address:$terminal_address")" || die "invalid terminal address"

  # Migrate clients created by the pre-special-workspace implementation.
  if [[ "$terminal_workspace" == "$legacy_workspace" || "$terminal_workspace" == "$special_workspace" ]]; then
    hl_dispatch "hl.dsp.window.move({ workspace = \"special:$special_workspace\", follow = false, window = $terminal_window })" >/dev/null
  fi

  if [[ "$action" == "hide" || "$action" == "cleanup" ]]; then
    active_address="$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // ""')"
    # The timer also fires after opening and focusing the dropdown. Ignore that
    # event; this is the tracked terminal rather than a genuine focus loss.
    [[ "$active_address" == "$terminal_address" ]] && exit 0

    # Applications launched from a menu while the terminal has focus inherit
    # its special workspace. Return that newly focused application to the
    # normal focused workspace before hiding the dropdown behind it.
    active_workspace="$(client_workspace "$active_address")"
    active_window=""
    if [[ "$active_workspace" == "special:$special_workspace" ]] && is_client_address "$active_address"; then
      focused_workspace="$(hyprctl monitors -j 2>/dev/null | jq -r \
        '.[] | select(.focused) | .activeWorkspace.name // "1"' | head -n 1)"
      focused_workspace="${focused_workspace:-1}"
      target_workspace="$(workspace_selector "$focused_workspace")"
      target_workspace_lua="$(lua_string "$target_workspace")" || die "invalid workspace name"
      active_window="$(lua_string "address:$active_address")" || die "invalid active window address"
      hl_dispatch "hl.dsp.window.move({ workspace = $target_workspace_lua, follow = false, window = $active_window })" >/dev/null
    fi

    # Cleanup always preserves the normal user's focus behavior. It only acts
    # when a foreign window inherited the dropdown's special workspace.
    if [[ "$action" == "cleanup" && -z "$active_window" ]]; then
      exit 0
    fi

    special_visible || exit 0
    hide_window "$terminal_address"
    transition_result=$?
    (( transition_result == 0 )) && record_lifecycle hidden "$terminal_address" || true
    if [[ -n "${active_window:-}" ]]; then
      focus_window "$active_window"
    fi
    exit "$transition_result"
  fi

  # Summoned while shown on another monitor: bring it to the focused one,
  # resized and positioned for that screen. Without this branch the window
  # either hid unexpectedly or migrated through the recovery path below with
  # its original size, which is wrong whenever the screens' scales differ.
  if special_visible && [[ "$action" == "toggle" ]]; then
    term_monitor="$(client_monitor "$terminal_address")"
    focused_id="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .id' | head -n 1)"
    if [[ "$focused_id" =~ ^[0-9]+$ && "$term_monitor" != "$focused_id" ]]; then
      compute_geometry_on "$focused_id"
      size_window "$terminal_address"
      move_window "$terminal_window" "$top_margin"
      focus_window "$terminal_window"
      transition_result=$?
      (( transition_result == 0 )) && record_lifecycle shown "$terminal_address" || true
      exit "$transition_result"
    fi
  fi

  # A second toggle hides the visible special workspace. Do not focus its
  # client afterward: focusing a hidden special-workspace window can reveal it.
  if special_visible && window_on_screen "$terminal_address"; then
    hide_window "$terminal_address"
    transition_result=$?
    (( transition_result == 0 )) && record_lifecycle hidden "$terminal_address" || true
    exit "$transition_result"
  fi

  # Recover a workspace left visible with the window still parked off screen.
  if special_visible; then
    compute_geometry
    move_window "$terminal_window" "$top_margin"
    focus_window "$terminal_window"
    transition_result=$?
    (( transition_result == 0 )) && record_lifecycle shown "$terminal_address" || true
    exit "$transition_result"
  fi

  show_window "$terminal_address"
  transition_result=$?
  (( transition_result == 0 )) && record_lifecycle shown "$terminal_address" || true
  exit "$transition_result"
fi

# Focus reconciliation and auto-hide are no-ops until the terminal exists;
# neither background action should create a terminal window.
if [[ "$action" == "hide" || "$action" == "cleanup" ]]; then
  # A missing managed client is a real closed transition when the state cache
  # still identifies it. Publish it so replay clears old unread completions.
  if is_client_address "$state_active"; then
    record_lifecycle closed "$state_active" || true
  fi
  exit 0
fi

before_clients=""
pending_launch=0
launch_pid=""
launch_pids=""
if [[ -e "$launch_file" ]]; then
  if pending_launch_before; then
    if launch_marker_stale; then
      debug "launch marker=expired"
      rm -f "$launch_file" 2>/dev/null || true
    else
      before_clients="$pending_before"
      pending_launch=1
      debug "launch marker=pending"
    fi
  else
    # A malformed marker cannot provide a safe baseline or process lineage.
    rm -f "$launch_file" 2>/dev/null || true
  fi
fi

if (( ! pending_launch )); then
  before_clients="$(hyprctl clients -j 2>/dev/null | jq -r '.[].address' | sort)"
  # Launch through Omarchy so xdg-terminal-exec selects the configured
  # emulator. The environment is scoped to this launch only. 9>&- keeps the
  # lock fd out of the launched terminal: it must outlive this script without
  # holding the lock.
  terminal_session="helper-${BASHPID:-$$}-${EPOCHREALTIME:-0}-${RANDOM}"
  YADTM_TERMINAL=1 YADTM_COMMAND_EVENTS="$event_file" \
    YADTM_TERMINAL_SESSION="$terminal_session" \
    omarchy launch terminal >/dev/null 2>&1 9>&- &
  launch_pid="$!"
  launch_pids=""
  # Capture the complete launch lineage before polling. A compositor client is
  # adopted only when its PID belongs to this observed tree; unrelated windows
  # created concurrently remain untouched.
  observe_launch_pids "$launch_pid"
  write_launch_marker "$before_clients" "$launch_pid" "$launch_pids" \
    || die "could not record pending terminal launch"
fi

current="$(poll_new_client "$before_clients" "$launch_pid" "$launch_pids" || true)"
if ! is_client_address "$current"; then
  # Keep the marker so the next toggle adopts a slow-mapping terminal instead
  # of launching a second one. This is an actionable failure, not a silent
  # successful no-op.
  die "terminal launch is still pending; retry the toggle to adopt it"
fi
rm -f "$launch_file" 2>/dev/null || true

current_window="$(lua_string "address:$current")" || die "invalid terminal address"
write_state "$current" "$current" || die "could not publish terminal state"
# Keep first-launch setup invisible while the initial window is moved out of
# the normal layout and configured at its final geometry. The mask is lifted
# here rather than inside show_window because the native-slide setting never
# unmasks; with a top drop, reveal_parked re-masks and lifts it at the moment
# the workspace becomes visible.
hyprctl eval "hl.dispatch(hl.dsp.window.set_prop({ window = $current_window, prop = \"opacity\", value = 0 }))" >/dev/null 2>&1 || true
compute_geometry
size_window "$current"
move_window "$current_window" "$top_margin"
hl_dispatch "hl.dsp.window.move({ workspace = \"special:$special_workspace\", follow = false, window = $current_window })" >/dev/null
hyprctl eval "hl.dispatch(hl.dsp.window.set_prop({ window = $current_window, prop = \"opacity\", value = 1 }))" >/dev/null 2>&1 || true
show_window "$current"
transition_result=$?
(( transition_result == 0 )) && record_lifecycle shown "$current" || true
exit "$transition_result"
