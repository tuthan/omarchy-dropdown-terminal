#!/usr/bin/env bash

set -u

config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.lua"
config_dir="$(dirname -- "$config")"
default_keybinding="CTRL + GRAVE"
keybinding="${2:-$default_keybinding}"
begin_marker="-- BEGIN Dropdown Terminal binding"
end_marker="-- END Dropdown Terminal binding"

# The value is inserted into a quoted Lua string. Keep the setting deliberately
# small and syntax-free so this helper can never turn it into Lua code.
valid_keybinding() {
  local value="$1"
  [[ -n "$value" && ${#value} -le 80 ]] || return 1
  [[ "$value" =~ ^[A-Za-z0-9_:+,[:space:]-]+$ ]]
}

if ! valid_keybinding "$keybinding"; then
  printf 'Dropdown Terminal: invalid keybinding: %s\n' "$keybinding" >&2
  exit 2
fi

line="hl.bind(\"$keybinding\", hl.dsp.global(\"io.github.tuthan.dropdown-terminal:toggle\"))"

status_json() {
  local installed=false conflicts='[]'
  [[ -f "$config" ]] && grep -Fqx -- "$line" "$config" && installed=true
  if [[ -f "$config" ]]; then
    conflicts="$(jq -Rn --arg generated "$line" --arg requested "$keybinding" '
      def canonical:
        ascii_upcase
        | gsub("[[:space:]]*[+,][[:space:]]*"; "+")
        | gsub("[[:space:]]+"; "")
        | gsub("GRAVE"; "CODE:41");
      def binding_key:
        if test("hl\\.bind\\(") then
          (capture("hl\\.bind\\(\\\"(?<key>[^\\\"]*)\\\"").key)
        elif test("^[[:space:]]*bind[[:space:]]*=") then
          sub("^[[:space:]]*bind[[:space:]]*=[[:space:]]*"; "")
          | split(",")
          | if length >= 2 then .[0] + " + " + .[1] else "" end
        else "" end;
      [inputs]
      | to_entries
      | map(select(.value != $generated
        and ((.value | test("^[[:space:]]*--")) | not)
        and ((.value | binding_key | canonical) == ($requested | canonical))))
      | map({lineNumber: (.key + 1), text: .value})' < "$config" 2>/dev/null || printf '[]')"
  fi
  jq -cn --arg config "$config" --arg line "$line" --arg keybinding "$keybinding" --argjson installed "$installed" \
    --argjson conflicts "$conflicts" \
    '{version: 1, available: true, supported: true, installed: $installed,
      config: $config, keybinding: $keybinding, line: $line, conflicts: $conflicts,
      conflictCount: ($conflicts | length)}'
}

config_errors_json() {
  local errors
  errors="$(hyprctl configerrors -j 2>/dev/null)" || {
    printf '[]\n'
    return 0
  }
  jq -ce 'if type == "array" then . else error("not an array") end' <<<"$errors" 2>/dev/null || printf '[]\n'
}

# Hyprland retains parsing errors from before a reload. Only a newly reported
# entry can be attributed to the binding edit; otherwise an unrelated warning
# makes every custom keybinding look like it failed.
check_config_errors() {
  local before="$1" after="$2"
  jq -ne --argjson before "$before" --argjson after "$after" \
    '($after - $before | length) == 0' >/dev/null 2>&1
}

rewrite_config() {
  local action="$1" temp mode="644" backup="" before_errors after_errors
  before_errors="$(config_errors_json)"
  mkdir -p "$config_dir" || return 1
  [[ -f "$config" ]] && mode="$(stat -c '%a' "$config" 2>/dev/null || printf '644')"
  temp="$(mktemp "$config_dir/.bindings.lua.dropdown-terminal.XXXXXX")" || return 1

  if [[ -f "$config" ]]; then
    awk -v begin="$begin_marker" -v end="$end_marker" -v line="$line" \
      -v remove_line="$([[ "$action" == "remove" ]] && printf 1 || printf 0)" '
      $0 == begin { skipping = 1; next }
      $0 == end { skipping = 0; next }
      skipping { next }
      $0 == line && remove_line { next }
      { print }
    ' "$config" > "$temp"
  fi

  if [[ "$action" == "install" ]]; then
    printf '\n%s\n%s\n%s\n' "$begin_marker" "$line" "$end_marker" >> "$temp"
  fi

  chmod "$mode" "$temp" 2>/dev/null || true
  if [[ -f "$config" ]]; then
    backup="$config.bak.$(date +%Y%m%d%H%M%S)"
    cp -p "$config" "$backup" || { rm -f "$temp"; return 1; }
  fi
  if ! mv -f "$temp" "$config"; then
    rm -f "$temp"
    return 1
  fi
  if ! hyprctl reload >/dev/null 2>&1; then
    notify-send "Dropdown Terminal" "Binding saved; reload Hyprland manually" >/dev/null 2>&1 || true
    return 1
  fi
  after_errors="$(config_errors_json)"
  if ! check_config_errors "$before_errors" "$after_errors"; then
    if [[ -n "$backup" ]]; then
      cp -p "$backup" "$config" || true
    else
      rm -f "$config"
    fi
    hyprctl reload >/dev/null 2>&1 || true
    notify-send "Dropdown Terminal" "Hyprland rejected the binding; changes were reverted" >/dev/null 2>&1 || true
    return 1
  fi
}

managed_block_present() {
  local expected actual
  [[ -f "$config" ]] || return 1
  expected="$(printf '%s\n%s\n%s\n' "$begin_marker" "$line" "$end_marker")"
  actual="$(awk -v begin="$begin_marker" -v end="$end_marker" '
    $0 == begin { block = $0 ORS; inside = 1; next }
    inside {
      block = block $0 ORS
      if ($0 == end) { print block; exit }
    }
  ' "$config")"
  [[ "$actual" == "$expected" ]]
}

managed_structure_safe() {
  [[ -f "$config" ]] || return 0
  awk -v begin="$begin_marker" -v end="$end_marker" '
    $0 == begin {
      if (inside) malformed = 1
      begins++
      inside = 1
      next
    }
    $0 == end {
      if (!inside) malformed = 1
      ends++
      inside = 0
      next
    }
    END { exit (malformed || inside || begins > 1 || ends > 1) ? 1 : 0 }
  ' "$config"
}

conflicts_present() {
  local report
  report="$(status_json)" || return 1
  jq -e '.conflictCount > 0' <<<"$report" >/dev/null 2>&1
}

acquire_mutation_lock() {
  mkdir -p "$config_dir" || return 1
  if ! exec 8>"$config_dir/.bindings.lua.dropdown-terminal.lock" 2>/dev/null; then
    return 1
  fi
  flock -w 3 8
}

action="${1:-install}"
case "$action" in
  status)
  status_json
  ;;
  install|install-force)
    acquire_mutation_lock || exit 1
    managed_structure_safe || exit 1
    if [[ -f "$config" ]] && grep -Fqx -- "$line" "$config"; then
      notify-send "Dropdown Terminal" "$keybinding is already bound" >/dev/null 2>&1 || true
      exit 0
    fi
    if [[ "$action" == "install" ]] && conflicts_present; then
      notify-send "Dropdown Terminal" "$keybinding is already used; review the conflict before installing" >/dev/null 2>&1 || true
      exit 1
    fi
    rewrite_config install || exit 1
    notify-send "Dropdown Terminal" "Bound $keybinding" >/dev/null 2>&1 || true
    ;;
  remove)
    if [[ ! -f "$config" ]] || ! grep -Fq -- 'io.github.tuthan.dropdown-terminal:toggle' "$config"; then
      exit 0
    fi
    acquire_mutation_lock || exit 1
    managed_structure_safe || exit 1
    if [[ ! -f "$config" ]] || ! grep -Fq -- 'io.github.tuthan.dropdown-terminal:toggle' "$config"; then
      exit 0
    fi
    rewrite_config remove || exit 1
    notify-send "Dropdown Terminal" "Removed the Dropdown Terminal binding" >/dev/null 2>&1 || true
    ;;
  *)
    printf 'Dropdown Terminal: unknown action: %s\n' "$action" >&2
    exit 2
    ;;
esac
