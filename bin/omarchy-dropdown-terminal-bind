#!/usr/bin/env bash

set -u

config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.lua"
line='hl.bind("CTRL + GRAVE", hl.dsp.global("io.github.tuthan.dropdown-terminal:toggle"))'

mkdir -p "$(dirname "$config")"

# Do not add a duplicate if the user already installed this action manually.
if [[ -f "$config" ]] && grep -Fq 'io.github.tuthan.dropdown-terminal:toggle' "$config"; then
  notify-send "Dropdown Terminal" "Ctrl + Grave is already bound" >/dev/null 2>&1 || true
  exit 0
fi

if [[ -f "$config" ]]; then
  backup="$config.bak.$(date +%Y%m%d%H%M%S)"
  cp -p "$config" "$backup"
fi

{
  printf '\n-- Dropdown Terminal\n'
  printf '%s\n' "$line"
} >> "$config"

if hyprctl reload >/dev/null 2>&1; then
  notify-send "Dropdown Terminal" "Bound Ctrl + Grave" >/dev/null 2>&1 || true
else
  notify-send "Dropdown Terminal" "Binding saved; reload Hyprland manually" >/dev/null 2>&1 || true
fi
